APP_NAME=Autonomous SOC
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://soc_app:soc_app_local_only@db:5432/soc
POSTGRES_OWNER_PASSWORD=replace-owner-password
POSTGRES_APP_PASSWORD=replace-app-password
SQL_ECHO=false
API_V1_PREFIX=/api/v1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
WAZUH_REQUEST_TIMEOUT_SECONDS=15
WAZUH_MAX_RETRIES=3
JWT_PRIVATE_KEY_PATH=/run/jwt/private.pem
JWT_PUBLIC_KEY_PATH=/run/jwt/public.pem
JWT_ACTIVE_KID=production-key-2026-01
# JSON map of previous kid -> public PEM for zero-downtime verification during rotation.
JWT_VERIFICATION_KEYS_JSON={}
JWT_ISSUER=autonomous-soc
JWT_AUDIENCE=autonomous-soc-api
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
MAX_REQUEST_BODY_BYTES=1048576
MAX_PAGE_SIZE=200
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=
ALLOW_PRIVATE_INTEGRATION_URLS=false
INTEGRATION_ALLOWED_HOSTS=
INTEGRATION_ALLOWED_PRIVATE_CIDRS=
OTEL_EXPORTER_OTLP_ENDPOINT=
SYNC_INTERVAL_SECONDS=300
CREDENTIAL_STORE_BACKEND=environment
DEMO_ADMIN_PASSWORD=
# JSON referenced by IntegrationAccount. Never place credentials in DATABASE_URL or API payloads.
# WAZUH_ACME_CREDENTIALS={"username":"wazuh-api-user","password":"change-me","verify_ssl":true,"indexer_url":"https://wazuh-indexer:9200","indexer_username":"soc-reader","indexer_password":"change-me"}
