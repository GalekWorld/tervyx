APP_NAME=Autonomous SOC
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://soc_app:soc_app_local_only@db:5432/soc
POSTGRES_OWNER_PASSWORD=replace-owner-password
POSTGRES_APP_PASSWORD=replace-app-password
SQL_ECHO=false
API_V1_PREFIX=/api/v1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
WAZUH_REQUEST_TIMEOUT_SECONDS=15
WAZUH_MAX_RETRIES=3
JWT_PRIVATE_KEY_PATH=/run/jwt/private.pem
JWT_PUBLIC_KEY_PATH=/run/jwt/public.pem
JWT_ACTIVE_KID=production-key-2026-01
# JSON map of previous kid -> public PEM for zero-downtime verification during rotation.
JWT_VERIFICATION_KEYS_JSON={}
JWT_ISSUER=autonomous-soc
JWT_AUDIENCE=autonomous-soc-api
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
SESSION_TTL_HOURS=12
OIDC_TRANSACTION_TTL_MINUTES=10
# Fernet key; generate externally and inject from the deployment secrets mechanism.
OIDC_TRANSACTION_KEY=
OIDC_HTTP_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=1048576
MAX_PAGE_SIZE=200
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=
ALLOW_PRIVATE_INTEGRATION_URLS=false
INTEGRATION_ALLOWED_HOSTS=
INTEGRATION_ALLOWED_PRIVATE_CIDRS=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRICS_EXPORT_INTERVAL_SECONDS=600
# Required in production; inject from external secret manager, never commit a real DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SYNC_INTERVAL_SECONDS=300
CREDENTIAL_STORE_BACKEND=environment
# Production alternatives: vault, openbao, aws_secrets_manager.
VAULT_ADDR=https://vault.example.internal:8200
VAULT_TOKEN=
VAULT_TOKEN_FILE=
OPENBAO_ADDR=https://openbao.example.internal:8200
OPENBAO_TOKEN=
OPENBAO_TOKEN_FILE=
AWS_REGION=eu-west-1
INGESTION_BATCH_SIZE=500
ALERT_CORRELATION_WINDOW_SECONDS=3600
TENANT_DEFAULT_MAX_EVENTS_PER_DAY=100000
TENANT_DEFAULT_MAX_JOBS_PER_MINUTE=1000
TENANT_DEFAULT_MAX_API_REQUESTS_PER_MINUTE=1000
TENANT_DEFAULT_MAX_STORAGE_BYTES=10737418240
TENANT_DEFAULT_MAX_QUEUE_DEPTH=5000
TENANT_FAIR_DISPATCH_BATCH_SIZE=64
RETENTION_DEFAULT_DAYS=90
RETENTION_ARCHIVE_AFTER_DAYS=30
# filesystem is development-only; production requires S3-compatible object storage.
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_BUCKET=tervyx-archive
OBJECT_STORAGE_PREFIX=tervyx
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=eu-west-1
OBJECT_STORAGE_LOCAL_PATH=/var/lib/tervyx/archive
BACKUP_S3_BUCKET=tervyx-backups
BACKUP_S3_PREFIX=postgres
PITR_ENABLED=false
DEMO_ADMIN_PASSWORD=
# JSON referenced by IntegrationAccount. Never place credentials in DATABASE_URL or API payloads.
# WAZUH_ACME_CREDENTIALS={"username":"wazuh-api-user","password":"change-me","verify_ssl":true,"indexer_url":"https://wazuh-indexer:9200","indexer_username":"soc-reader","indexer_password":"change-me"}
